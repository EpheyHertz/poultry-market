  createdAt  DateTime       @default(now())
  post       BlogPost       @relation("BlogPostResources", fields: [postId], references: [id], onDelete: Cascade)
  resource   AuthorResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, postId])
  @@index([postId])
  @@map("author_resource_articles")
}

