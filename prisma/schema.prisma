/// Author-curated external recommendation (product, guide, service...).
///
/// Metadata is resolved ONCE when the author saves the resource and stored here,
/// so rendering a public author profile never makes an outbound request to
/// Amazon/Jumia/etc. Belongs to the existing AuthorProfile — there is no separate
/// affiliate author identity.
model AuthorResource {
  id                  String                  @id @default(cuid())
  profileId           String
  title               String
  description         String?
  imageUrl            String?
  url                 String
  domain              String
  merchant            String?
  isAffiliate         Boolean                 @default(false)
  affiliateDisclosure String?
  isActive            Boolean                 @default(true)
  displayOrder        Int                     @default(0)
  clickCount          Int                     @default(0)
  /// When the stored metadata was last resolved from the destination.
  metadataFetchedAt   DateTime?
  /// False when the destination returned no usable Open Graph metadata and the
  /// author supplied the title/description/image manually.
  metadataResolved    Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  articles            AuthorResourceArticle[]
  profile             AuthorProfile           @relation("AuthorProfileResources", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isActive, displayOrder])
  @@map("author_resources")
}

/// Explicit many-to-many join between a recommended resource and a blog post.
/// Prevents irrelevant affiliate content appearing on unrelated articles.
model AuthorResourceArticle {
