generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  password                String?
  googleId                String?                  @unique
  name                    String
  phone                   String?
  avatar                  String?
  role                    UserRole                 @default(CUSTOMER)
  isActive                Boolean                  @default(true)
  isVerified              Boolean                  @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bio                     String?
  location                String?
  website                 String?
  customDomain            String?
  dashboardSlug           String?
  qrCode                  String?
  agentId                 String?                  @unique
  vehicleType             String?
  vehicleNumber           String?
  licenseNumber           String?
  coverageArea            String?
  isApproved              Boolean                  @default(false)
  deliveryCounties        String[]                 @default([])
  deliveryFeePerKm        Float?                   @default(0)
  deliveryProvinces       String[]                 @default([])
  minOrderForFreeDelivery Float?
  offersDelivery          Boolean                  @default(false)
  offersFreeDelivery      Boolean                  @default(false)
  offersPayAfterDelivery  Boolean                  @default(false)
  analytics               Analytics[]
  announcementReactions   AnnouncementReaction[]
  announcementViews       AnnouncementView[]
  announcements           Announcement[]
  apiKeys                 ApiKey[]
  applications            Application[]
  attachments             Attachment[]
  authorProfile           AuthorProfile?
  blogCommentLikes        BlogCommentLike[]        @relation("BlogCommentLikes")
  blogComments            BlogComment[]
  moderatedComments       BlogComment[]            @relation("CommentModerator")
  blogPostLikes           BlogPostLike[]           @relation("BlogPostLikes")
  blogPostViews           BlogPostView[]           @relation("UserBlogViews")
  approvedBlogPosts       BlogPost[]               @relation("BlogPostApprovedBy")
  blogPosts               BlogPost[]
  cartItems               CartItem[]
  sentMessages            ChatMessage[]            @relation("SentMessages")
  chatsAsParticipant1     Chat[]                   @relation("ChatParticipant1")
  chatsAsParticipant2     Chat[]                   @relation("ChatParticipant2")
  checkoutSessions        CheckoutSession[]
  deliveries              Delivery[]
  deliveryJobs            DeliveryJob[]            @relation("DeliveryPartnerJobs")
  deliveryPartner         DeliveryPartner?
  uploadedDeliveryPhotos  DeliveryPhoto[]
  adminDeliveryApprovals  DeliveryProof[]          @relation("DeliveryProofApprover")
  deliveryProofs          DeliveryProof[]          @relation("DeliveryProofSubmitter")
  eggRecords              EggRecord[]
  farmEmailPreference     FarmEmailPreference?
  farmImportJobs          FarmImportJob[]
  farmInvitationsSent     FarmMember[]             @relation("FarmMemberInviter")
  farmMemberships         FarmMember[]
  ownedFarms              Farm[]                   @relation("OwnedFarms")
  feedRecords             FeedRecord[]
  flocks                  Flock[]
  following               Follow[]                 @relation("Following")
  followers               Follow[]                 @relation("Followers")
  hatchingRequests        HatchingRequest[]
  inventoryLogs           InventoryLog[]
  livestockFlocks         LivestockFlock[]
  messageReactions        MessageReaction[]        @relation("MessageReactions")
  mortalityRecords        MortalityRecord[]
  receivedNotifications   Notification[]           @relation("NotificationReceiver")
  sentNotifications       Notification[]           @relation("NotificationSender")
  approvedOrders          Order[]                  @relation("OrderApprovals")
  orders                  Order[]
  sellerOrders            Order[]                  @relation("SellerOrders")
  paymentApprovals        PaymentApprovalLog[]
  payments                Payment[]
  productLikes            ProductLike[]
  products                Product[]
  reminders               Reminder[]
  reviewLikes             ReviewLike[]
  reviewReplies           ReviewReply[]
  reviews                 Review[]
  sales                   Sale[]
  sellerCommission        SellerCommission?
  sponsorshipApplications SponsorshipApplication[] @relation("SellerSponsorshipApplications")
  companySponsorships     Sponsorship[]            @relation("CompanySponsorships")
  sellerSponsorships      Sponsorship[]            @relation("SellerSponsorships")
  sponsorships            Sponsorship[]            @relation("UserSponsorships")
  store                   Store?                   @relation("StoreOwner")
  subscription            Subscription?
  supportTransactions     SupportTransaction[]     @relation("SupporterTransactions")
  tags                    UserTag[]
  vaccinations            Vaccination[]
  vouchers                Voucher[]
  walletTransactions      WalletTransaction[]      @relation("WalletTransactions")
  wallets                 Wallet[]
  receivedSponsorships    Sponsorship[]            @relation("SponsorshipReceiver")

  @@map("users")
}

model Farm {
  id                 String             @id @default(cuid())
  name               String
  slug               String?            @unique
  ownerId            String
  settings           Json?
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionEndsAt DateTime?
  billingEmail       String?
  billingProvider    String?
  billingReference   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attachments        Attachment[]
  eggRecords         EggRecord[]
  farmImportJobs     FarmImportJob[]
  members            FarmMember[]
  roles              FarmRole[]
  owner              User               @relation("OwnedFarms", fields: [ownerId], references: [id], onDelete: Cascade)
  feedRecords        FeedRecord[]
  flocks             Flock[]
  mortalityRecords   MortalityRecord[]
  reminders          Reminder[]
  vaccinations       Vaccination[]

  @@index([ownerId])
  @@map("farms")
}

model FarmRole {
  id          String       @id @default(cuid())
  farmId      String
  name        String
  key         String?
  rank        Int
  permissions String[]     @default([])
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     FarmMember[]
  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, name])
  @@index([farmId, rank])
  @@map("farm_roles")
}

model FarmMember {
  id                  String           @id @default(cuid())
  farmId              String
  userId              String?
  roleId              String
  invitedById         String?
  invitedEmail        String
  invitationTokenHash String?
  invitationExpiresAt DateTime?
  status              FarmMemberStatus @default(PENDING)
  rank                Int              @default(0)
  invitedAt           DateTime         @default(now())
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  farm                Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  invitedBy           User?            @relation("FarmMemberInviter", fields: [invitedById], references: [id])
  role                FarmRole         @relation(fields: [roleId], references: [id])
  user                User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, invitedEmail])
  @@unique([farmId, userId])
  @@index([farmId, status])
  @@index([userId])
  @@map("farm_members")
}

model Product {
  id                String              @id @default(cuid())
  name              String
  description       String
  price             Float
  stock             Int
  type              ProductType
  images            String[]
  sellerId          String
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  slug              String?             @unique
  metaTitle         String?
  metaDescription   String?
  hasDiscount       Boolean             @default(false)
  discountType      DiscountType?
  discountAmount    Float?
  discountStartDate DateTime?
  discountEndDate   DateTime?
  customType        String?
  sku               String?
  storeId           String?
  unitType          String?
  vaccinationStatus String?
  announcements     Announcement[]
  cartItems         CartItem[]
  chats             Chat[]
  checkoutSessions  CheckoutSession[]
  inventoryLogs     InventoryLog[]
  orderItems        OrderItem[]
  categories        ProductCategory[]
  collections       ProductCollection[]
  likes             ProductLike[]
  tags              ProductTag[]
  seller            User                @relation(fields: [sellerId], references: [id])
  store             Store?              @relation(fields: [storeId], references: [id])
  reviews           Review[]
  saleItems         SaleItem[]

  @@index([storeId])
  @@map("products")
}

model ProductTag {
  id        String   @id @default(cuid())
  productId String
  tag       TagType
  addedAt   DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tag])
  @@map("product_tags")
}

model Order {
  id                    String               @id @default(cuid())
  customerId            String
  status                OrderStatus          @default(PENDING)
  total                 Float
  subtotal              Float                @default(0)
  discountAmount        Float                @default(0)
  deliveryFee           Float                @default(0)
  voucherCode           String?
  notes                 String?
  rejectionReason       String?
  paymentType           PaymentType          @default(BEFORE_DELIVERY)
  paymentStatus         PaymentStatus        @default(UNPAID)
  paymentDetails        String?
  paymentPhone          String?
  paymentReference      String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deliveryCounty        String?
  deliveryProvince      String?
  sellerHandlesDelivery Boolean              @default(false)
  approvedAt            DateTime?
  approvedBy            String?
  completedAt           DateTime?
  deliveryAddress       String?
  deliveryProofImages   String[]             @default([])
  deliveryProofMessage  String?
  isReviewed            Boolean              @default(false)
  markedReceivedAt      DateTime?
  paymentMethod         PaymentMethod        @default(MPESA)
  reviewId              String?
  sellerId              String?
  escrowAmount          Float?
  escrowReleasedAt      DateTime?
  escrowStatus          EscrowStatus         @default(NONE)
  storeId               String?
  chats                 Chat[]
  delivery              Delivery?
  deliveryJobs          DeliveryJob[]
  deliveryProof         DeliveryProof?
  invoice               Invoice?
  notifications         Notification[]
  items                 OrderItem[]
  timeline              OrderTimeline[]
  approver              User?                @relation("OrderApprovals", fields: [approvedBy], references: [id])
  customer              User                 @relation(fields: [customerId], references: [id])
  seller                User?                @relation("SellerOrders", fields: [sellerId], references: [id])
  store                 Store?               @relation(fields: [storeId], references: [id])
  paymentApprovals      PaymentApprovalLog[]
  paymentInvoices       PaymentInvoice[]
  payment               Payment?

  @@index([storeId])
  @@map("orders")
}

model OrderTimeline {
  id          String   @id @default(cuid())
  orderId     String
  action      String
  description String?
  oldStatus   String?
  newStatus   String?
  actorId     String?
  actorRole   String?
  actorName   String?
  metadata    String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_timeline")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  price           Float
  discountApplied Float   @default(0)
  order           Order   @relation(fields: [orderId], references: [id])
  product         Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Delivery {
  id                    String          @id @default(cuid())
  orderId               String          @unique
  fee                   Float           @default(0)
  agentId               String?
  address               String
  trackingId            String          @unique
  status                DeliveryStatus  @default(ASSIGNED)
  estimatedDelivery     DateTime?
  actualDelivery        DateTime?
  pickupTime            DateTime?
  dispatchTime          DateTime?
  deliveryNotes         String?
  agentName             String?
  agentPhone            String?
  vehicleInfo           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  county                String?
  province              String?
  sellerHandlesDelivery Boolean         @default(false)
  agent                 User?           @relation(fields: [agentId], references: [id])
  order                 Order           @relation(fields: [orderId], references: [id])
  deliveryPhotos        DeliveryPhoto[]

  @@map("deliveries")
}

model DeliveryPhoto {
  id                 String            @id @default(cuid())
  deliveryId         String
  uploadedBy         String
  photoUrl           String
  cloudinaryPublicId String?
  caption            String?
  photoType          DeliveryPhotoType @default(DELIVERY_PROOF)
  createdAt          DateTime          @default(now())
  delivery           Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  uploader           User              @relation(fields: [uploadedBy], references: [id])

  @@map("delivery_photos")
}

model DeliveryVoucher {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String?
  description    String?
  discountType   VoucherType
  discountValue  Float
  minOrderAmount Float       @default(0)
  maxUses        Int         @default(1)
  usedCount      Int         @default(0)
  expiresAt      DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("delivery_vouchers")
}

model DeliveryFee {
  id          String   @id @default(uuid())
  name        String
  amount      Float
  description String?
  isDefault   Boolean  @default(false)
  zones       String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  userId            String
  amount            Float
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  phoneNumber       String?
  transactionCode   String?
  mpesaMessage      String?
  description       String?
  referenceNumber   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  callbackData      String?
  callbackReceived  Boolean       @default(false)
  externalReference String?
  failureReason     String?
  metadata          String?
  stkPushData       String?
  order             Order         @relation(fields: [orderId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@map("payments")
}

model PaymentApprovalLog {
  id         String   @id @default(cuid())
  orderId    String
  approverId String
  action     String
  notes      String?
  createdAt  DateTime @default(now())
  approver   User     @relation(fields: [approverId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])

  @@map("payment_approval_logs")
}

model PaymentInvoice {
  id             String               @id @default(cuid())
  invoiceId      String               @unique
  orderId        String?
  provider       String               @default("intasend")
  status         PaymentInvoiceStatus @default(CREATED)
  amount         Float
  expectedAmount Float?
  phoneNumber    String?
  isUsed         Boolean              @default(false)
  expiresAt      DateTime
  metadata       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  order          Order?               @relation(fields: [orderId], references: [id])

  @@map("payment_invoices")
}

model Voucher {
  id                     String        @id @default(cuid())
  code                   String        @unique
  name                   String?
  description            String?
  discountType           VoucherType
  discountValue          Float
  minOrderAmount         Float         @default(0)
  maxDiscountAmount      Float?
  validFrom              DateTime
  validUntil             DateTime
  maxUses                Int           @default(1)
  usedCount              Int           @default(0)
  isActive               Boolean       @default(true)
  createdById            String
  applicableRoles        UserRole[]
  applicableProductTypes ProductType[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  createdBy              User          @relation(fields: [createdById], references: [id])

  @@map("vouchers")
}

model Review {
  id        String        @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String
  images    String[]
  isVisible Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  likes     ReviewLike[]
  replies   ReviewReply[]
  product   Product       @relation(fields: [productId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@map("reviews")
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
  @@map("review_likes")
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("review_replies")
}

model HatchingRequest {
  id         String            @id @default(cuid())
  customerId String
  eggType    String
  quantity   Int
  purpose    String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  customer   User              @relation(fields: [customerId], references: [id])

  @@map("hatching_requests")
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  requestedRole UserRole
  businessName  String?
  businessType  String?
  description   String?
  documents     String[]
  status        ApplicationStatus @default(PENDING)
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewNotes   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("applications")
}

model Sponsorship {
  id           String                   @id @default(cuid())
  companyId    String
  sellerId     String?
  userId       String?
  amount       Float
  description  String
  terms        String?
  duration     Int?
  benefits     String[]
  status       SponsorshipStatus        @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  applications SponsorshipApplication[]
  company      User                     @relation("CompanySponsorships", fields: [companyId], references: [id], onDelete: Cascade)
  seller       User?                    @relation("SellerSponsorships", fields: [sellerId], references: [id])
  user         User?                    @relation("UserSponsorships", fields: [userId], references: [id])
  User         User[]                   @relation("SponsorshipReceiver")

  @@map("sponsorships")
}

model SponsorshipApplication {
  id              String                       @id @default(cuid())
  sponsorshipId   String
  sellerId        String
  message         String?
  businessDetails Json?
  status          SponsorshipApplicationStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  seller          User                         @relation("SellerSponsorshipApplications", fields: [sellerId], references: [id], onDelete: Cascade)
  sponsorship     Sponsorship                  @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)

  @@unique([sponsorshipId, sellerId])
  @@map("sponsorship_applications")
}

model UserTag {
  id      String   @id @default(cuid())
  userId  String
  tag     TagType
  addedBy String?
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id])

  @@unique([userId, tag])
  @@map("user_tags")
}

model Analytics {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @default(now())
  totalSales      Float    @default(0)
  orderCount      Int      @default(0)
  productViews    Int      @default(0)
  fulfillmentRate Float    @default(0)
  averageRating   Float    @default(0)
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("analytics")
}

model Notification {
  id         String           @id @default(cuid())
  senderId   String?
  receiverId String
  orderId    String?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  sentAt     DateTime?
  createdAt  DateTime         @default(now())
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receiver   User             @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User?            @relation("NotificationSender", fields: [senderId], references: [id])

  @@map("notifications")
}

model ProductLike {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_likes")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Chat {
  id             String        @id @default(cuid())
  participant1Id String
  participant2Id String
  productId      String?
  orderId        String?
  lastMessage    String?
  lastMessageAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       ChatMessage[]
  order          Order?        @relation(fields: [orderId], references: [id])
  participant1   User          @relation("ChatParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User          @relation("ChatParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  product        Product?      @relation(fields: [productId], references: [id])

  @@unique([participant1Id, participant2Id, productId])
  @@unique([participant1Id, participant2Id, orderId])
  @@map("chats")
}

model ChatMessage {
  id          String            @id @default(cuid())
  chatId      String
  senderId    String
  content     String
  type        String            @default("text")
  images      String[]
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?
  deliveredAt DateTime?
  editedAt    DateTime?
  isDeleted   Boolean           @default(false)
  isEdited    Boolean           @default(false)
  readAt      DateTime?
  replyToId   String?
  updatedAt   DateTime          @updatedAt
  chat        Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  replyTo     ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     ChatMessage[]     @relation("MessageReplies")
  sender      User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  files       MessageFile[]
  reactions   MessageReaction[]

  @@map("chat_messages")
}

model MessageFile {
  id        String      @id @default(cuid())
  messageId String
  name      String
  url       String
  type      String
  size      Int
  mimeType  String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_files")
}

model MessageReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model Category {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  icon        String?
  image       String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductCategory[]

  @@map("categories")
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model Collection {
  id          String              @id @default(cuid())
  name        String              @unique
  slug        String              @unique
  description String?
  image       String?
  isActive    Boolean             @default(true)
  isFeatured  Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    ProductCollection[]

  @@map("collections")
}

model ProductCollection {
  id           String     @id @default(cuid())
  productId    String
  collectionId String
